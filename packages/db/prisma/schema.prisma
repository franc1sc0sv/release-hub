generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src"
  fileName = "types.ts"
}

datasource db {
  provider = "postgresql"
}

enum FeatureKind {
  product
  default

  @@map("feature_kind")
}

enum FeatureState {
  in_progress
  shipped_flag_off
  ready_to_release
  partial
  fully_released
  blocked
  completed

  @@map("feature_state")
}

enum FeatureTimelineScope {
  feature
  release

  @@map("feature_timeline_scope")
}

enum FeatureTimelineSource {
  user
  flag_decision
  system

  @@map("feature_timeline_source")
}

enum ReleaseType {
  feature
  hotfix

  @@map("release_type")
}

enum AiDraftStatus {
  pending
  running
  ready
  failed

  @@map("ai_draft_status")
}

enum AiSummaryStatus {
  idle
  generating
  ready
  failed

  @@map("ai_summary_status")
}

enum ReleaseStatus {
  draft
  ready_to_release
  merged
  deployed
  canceled

  @@map("release_status")
}

enum FlagAction {
  added
  modified
  removed
  unchanged

  @@map("flag_action")
}

enum FlagReferenceKind {
  DEFINITION
  USAGE

  @@map("flag_reference_kind")
}

enum ReleaseFlagDecisionType {
  ENABLE_IN_RELEASE
  SHIP_OFF
  in_progress

  @@map("release_flag_decision_type")
}

enum TicketSource {
  LINEAR
  JIRA

  @@map("ticket_source")
}

enum OrgRole {
  owner
  member
  viewer

  @@map("org_role")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_status")
}

enum GithubInstallationStatus {
  active
  suspended
  deleted
}

enum SummaryExampleKind {
  good
  bad

  @@map("summary_example_kind")
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String?   @unique
  githubInstallationId String?   @map("github_installation_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  memberships OrganizationMembership[]
  projects    Project[]
  invitations Invitation[]
  githubInstallations GithubInstallation[]

  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           OrgRole  @default(member)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  loginCodes        LoginCode[]
  refreshTokens     RefreshToken[]
  organizationMemberships OrganizationMembership[]
  invitationsSent   Invitation[]       @relation("InvitedBy")
  flagDecisions     ReleaseFlagDecision[]
  notificationPreferences UserNotificationPreference[]
  createdBlockedBranches  BlockedBranch[]
  flagHistoryEvents       FlagHistoryEvent[]
  notifications           Notification[]
  featureStateEvents      FeatureStateEvent[]

  @@index([deletedAt])
  @@map("users")
}

model GithubInstallation {
  id                  String                   @id @default(cuid())
  installationId      BigInt                   @unique @map("installation_id")
  organizationId      String?                  @map("organization_id")
  accountLogin        String                   @map("account_login")
  accountType         String                   @map("account_type")
  accountId           BigInt                   @map("account_id")
  repositorySelection String                   @map("repository_selection")
  status              GithubInstallationStatus @default(active)
  suspendedAt         DateTime?                @map("suspended_at")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  organization Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  repositories GithubInstallationRepo[]

  @@index([organizationId])
  @@map("github_installations")
}

model GithubInstallationRepo {
  id                 String   @id @default(cuid())
  installationRowId  String   @map("installation_row_id")
  repoId             BigInt   @map("repo_id")
  fullName           String   @map("full_name")
  private            Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")

  installation GithubInstallation @relation(fields: [installationRowId], references: [id], onDelete: Cascade)

  @@unique([installationRowId, repoId])
  @@index([fullName])
  @@map("github_installation_repos")
}

model GithubInstallState {
  id             String    @id @default(cuid())
  nonce          String    @unique
  organizationId String    @map("organization_id")
  projectId      String?   @map("project_id")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("github_install_states")
}

model ProjectLinearConnection {
  id             String    @id @default(cuid())
  projectId      String    @unique @map("project_id")
  accessToken    String    @map("access_token")
  refreshToken   String?   @map("refresh_token")
  expiresAt      DateTime? @map("expires_at")
  linearUserId   String    @map("linear_user_id")
  linearUserName String    @map("linear_user_name")
  scopes         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_linear_connections")
}

model LinearOAuthState {
  id         String    @id @default(cuid())
  nonce      String    @unique
  userId     String    @map("user_id")
  projectId  String    @map("project_id")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("linear_oauth_states")
}

model LoginCode {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("login_codes")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Project {
  id          String    @id @default(cuid())
  organizationId String @map("organization_id")
  name        String
  repo        String
  githubInstallationId String? @map("github_installation_id")
  flagsmithEnabled Boolean @default(false) @map("flagsmith_enabled")
  flagsmithUrl     String? @map("flagsmith_url")
  flagsmithApiKey  String? @map("flagsmith_api_key")
  flagsmithProjectId String? @map("flagsmith_project_id")
  flagsmithWebhookSecret String? @map("flagsmith_webhook_secret")
  githubWebhookSecret    String? @map("github_webhook_secret")
  slackEnabled     Boolean @default(false) @map("slack_enabled")
  flagStaleDays    Int     @default(14) @map("flag_stale_days")
  linearEnabled    Boolean @default(false) @map("linear_enabled")
  flagRegistryPath   String? @map("flag_registry_path")
  flagRegistryBranch String? @map("flag_registry_branch")
  flagReminderIntervalDays Int @default(7) @map("flag_reminder_interval_days")
  conflictEnvironments String[] @default([]) @map("conflict_environments")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  features    Feature[]
  releases    Release[]
  projectTags ProjectTag[]
  linearConnection ProjectLinearConnection?
  trackedFlags TrackedFlag[]
  flagsmithEnvironments FlagsmithEnvironment[]
  flagsmithFlags        FlagsmithFlag[]
  flagsmithSyncRuns     FlagsmithSyncRun[]
  slackConnection       ProjectSlackConnection?
  notificationPreferences UserNotificationPreference[]
  blockedBranches       BlockedBranch[]
  flagHistoryEvents     FlagHistoryEvent[]
  notifications         Notification[]
  summaryProfiles       SummaryProfile[]

  @@index([deletedAt])
  @@index([organizationId])
  @@map("projects")
}

model Feature {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  name        String
  description String
  kind        FeatureKind @default(product)
  tags        String[]
  suggested   Boolean     @default(false)
  state       FeatureState @default(in_progress) @map("state")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequests    PullRequest[]
  featureInReleases FeatureInRelease[]
  trackedFlags    TrackedFlag[]
  stateEvents     FeatureStateEvent[]

  @@index([projectId, deletedAt])
  @@map("features")
}

model FeatureStateEvent {
  id         String                @id @default(cuid())
  featureId  String                @map("feature_id")
  releaseId  String?               @map("release_id")
  scope      FeatureTimelineScope
  source     FeatureTimelineSource
  fromState  FeatureState?         @map("from_state")
  toState    FeatureState          @map("to_state")
  actorId    String?               @map("actor_id")
  flagKey    String?               @map("flag_key")
  occurredAt DateTime              @default(now()) @map("occurred_at")

  feature Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  release Release? @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([featureId, occurredAt])
  @@index([releaseId])
  @@map("feature_state_events")
}

model Release {
  id               String        @id @default(cuid())
  projectId        String        @map("project_id")
  name             String?
  baseRef          String        @map("base_ref")
  compareRef       String        @map("compare_ref")
  status           ReleaseStatus @default(draft)
  aiDraftStatus    AiDraftStatus @default(pending) @map("ai_draft_status")
  prUrl            String?       @map("pr_url")
  tags             String[]      @default([])
  summary          String?
  summaryEditedAt  DateTime?     @map("summary_edited_at")
  deployedAt         DateTime? @map("deployed_at")
  githubDeploymentId String?   @map("github_deployment_id")
  summaryProfileId String?       @map("summary_profile_id")
  summaryModel     String?       @map("summary_model")
  summaryStatus    AiSummaryStatus @default(idle) @map("summary_status")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequests      PullRequest[]
  featureInReleases FeatureInRelease[]
  flagDecisions     ReleaseFlagDecision[]
  flagHistoryEvents FlagHistoryEvent[]
  featureStateEvents FeatureStateEvent[]
  summaryProfile    SummaryProfile?   @relation(fields: [summaryProfileId], references: [id], onDelete: SetNull)

  @@index([projectId, deletedAt])
  @@map("releases")
}

model PullRequest {
  id           String   @id @default(cuid())
  number       Int
  title        String
  body         String?
  author       String
  mergedAt     DateTime @map("merged_at")
  releaseId    String   @map("release_id")
  featureId    String?  @map("feature_id")
  aiConfidence Float?   @map("ai_confidence")
  aiRationale  String?  @map("ai_rationale")
  summary         String?   @map("summary")
  summaryEditedAt DateTime? @map("summary_edited_at")
  pendingAddition Boolean  @default(false) @map("pending_addition")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  release     Release      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  feature     Feature?     @relation(fields: [featureId], references: [id], onDelete: SetNull)
  commits     Commit[]
  ticketLinks TicketLink[]
  flagChanges PullRequestFlagChange[]
  flagsAdded   TrackedFlag[] @relation("FlagAddedIn")
  flagsRemoved TrackedFlag[] @relation("FlagRemovedIn")

  @@unique([releaseId, number])
  @@index([releaseId])
  @@index([featureId])
  @@map("pull_requests")
}

model Commit {
  id            String   @id @default(cuid())
  pullRequestId String   @map("pull_request_id")
  sha           String
  message       String
  author        String
  committedAt   DateTime @map("committed_at")

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@unique([pullRequestId, sha])
  @@index([pullRequestId])
  @@map("commits")
}

model FeatureInRelease {
  id         String       @id @default(cuid())
  featureId  String       @map("feature_id")
  releaseId  String       @map("release_id")
  state      FeatureState @default(in_progress)
  flagStaging   Boolean?  @map("flag_staging")
  flagProduction Boolean? @map("flag_production")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  release Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([featureId, releaseId])
  @@index([releaseId])
  @@map("feature_in_releases")
}

model TicketLink {
  id            String       @id @default(cuid())
  pullRequestId String       @map("pull_request_id")
  issueId       String       @map("issue_id")
  source        TicketSource
  url           String
  title         String
  description   String?
  confidence    Float

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@map("ticket_links")
}

model TrackedFlag {
  id                    String   @id @default(cuid())
  projectId             String   @map("project_id")
  key                   String
  featureId             String?  @map("feature_id")
  addedInPullRequestId  String?  @map("added_in_pull_request_id")
  removedInPullRequestId String? @map("removed_in_pull_request_id")
  presentInCode         Boolean  @default(true) @map("present_in_code")
  lastRemindedAt        DateTime? @map("last_reminded_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  deletedAt             DateTime? @map("deleted_at")

  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feature           Feature?             @relation(fields: [featureId], references: [id], onDelete: SetNull)
  addedInPullRequest    PullRequest?     @relation("FlagAddedIn", fields: [addedInPullRequestId], references: [id], onDelete: SetNull)
  removedInPullRequest  PullRequest?     @relation("FlagRemovedIn", fields: [removedInPullRequestId], references: [id], onDelete: SetNull)
  branchPresence    FlagBranchPresence[]
  pullRequestChanges PullRequestFlagChange[]
  releaseDecisions  ReleaseFlagDecision[]
  flagsmithFlags    FlagsmithFlag[]
  historyEvents     FlagHistoryEvent[]

  @@unique([projectId, key])
  @@index([projectId, deletedAt])
  @@map("tracked_flag")
}

model FlagBranchPresence {
  id              String    @id @default(cuid())
  trackedFlagId   String    @map("tracked_flag_id")
  branch          String
  present         Boolean   @default(true)
  headSha         String?   @map("head_sha")
  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastConfirmedAt DateTime  @default(now()) @map("last_confirmed_at")

  trackedFlag TrackedFlag @relation(fields: [trackedFlagId], references: [id], onDelete: Cascade)

  @@unique([trackedFlagId, branch])
  @@map("flag_branch_presence")
}

model PullRequestFlagChange {
  id            String            @id @default(cuid())
  pullRequestId String            @map("pull_request_id")
  trackedFlagId String            @map("tracked_flag_id")
  action        FlagAction
  kind          FlagReferenceKind @default(USAGE)
  detectedFile  String?           @map("detected_file")
  createdAt     DateTime          @default(now()) @map("created_at")

  pullRequest PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  trackedFlag TrackedFlag @relation(fields: [trackedFlagId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([trackedFlagId])
  @@map("pull_request_flag_change")
}

model ReleaseFlagDecision {
  id            String                  @id @default(cuid())
  releaseId     String                  @map("release_id")
  trackedFlagId String                  @map("tracked_flag_id")
  decision      ReleaseFlagDecisionType
  decidedById   String?                 @map("decided_by_id")
  decidedAt     DateTime?               @map("decided_at")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  release     Release     @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  trackedFlag TrackedFlag @relation(fields: [trackedFlagId], references: [id], onDelete: Cascade)
  decidedBy   User?       @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([releaseId, trackedFlagId])
  @@map("release_flag_decision")
}

model ProjectTag {
  id        String    @id @default(cuid())
  projectId String    @map("project_id")
  name      String
  color     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, deletedAt])
  @@map("project_tags")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  email          String
  role           OrgRole          @default(member)
  token          String           @unique @default(cuid())
  status         InvitationStatus @default(pending)
  expiresAt      DateTime         @map("expires_at")
  invitedById    String           @map("invited_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([token])
  @@map("invitations")
}

enum FlagsmithSyncSource {
  initial
  manual
  webhook

  @@map("flagsmith_sync_source")
}

enum FlagsmithSyncStatus {
  running
  completed
  failed

  @@map("flagsmith_sync_status")
}

enum NotificationChannel {
  email
  slack_dm
  in_app

  @@map("notification_channel")
}

enum NotificationType {
  release_created
  release_shipped
  release_deployed
  flag_in_progress_reminder
  flag_staleness_alert
  flag_digest
  flag_created
  flag_deleted
  flag_enabled
  flag_disabled
  flag_value_changed
  flag_conflict
  flag_ship_off_reminder

  @@map("notification_type")
}

enum DigestFrequency {
  daily
  weekly

  @@map("digest_frequency")
}

model FlagsmithEnvironment {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  name            String
  flagsmithApiKey String   @map("flagsmith_api_key")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  states  FlagsmithFlagState[]

  @@unique([projectId, name])
  @@map("flagsmith_environments")
}

model FlagsmithFlag {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  key                String
  flagsmithFeatureId String?   @map("flagsmith_feature_id")
  trackedFlagId      String?   @map("tracked_flag_id")
  flagCreatedAt      DateTime? @map("flag_created_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedFlag TrackedFlag?         @relation(fields: [trackedFlagId], references: [id], onDelete: SetNull)
  states      FlagsmithFlagState[]
  historyEvents FlagHistoryEvent[]

  @@unique([projectId, key])
  @@index([projectId, deletedAt])
  @@map("flagsmith_flags")
}

model FlagsmithFlagState {
  id            String   @id @default(cuid())
  flagId        String   @map("flag_id")
  environmentId String   @map("environment_id")
  enabled       Boolean
  value         String?  @map("value")
  updatedAt     DateTime @updatedAt @map("updated_at")

  flag        FlagsmithFlag        @relation(fields: [flagId], references: [id], onDelete: Cascade)
  environment FlagsmithEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([flagId, environmentId])
  @@map("flagsmith_flag_states")
}

model FlagsmithSyncRun {
  id         String              @id @default(cuid())
  projectId  String              @map("project_id")
  source     FlagsmithSyncSource
  status     FlagsmithSyncStatus
  flagCount  Int                 @default(0) @map("flag_count")
  startedAt  DateTime            @default(now()) @map("started_at")
  finishedAt DateTime?           @map("finished_at")
  error      String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("flagsmith_sync_runs")
}

model ProjectSlackConnection {
  id              String   @id @default(cuid())
  projectId       String   @unique @map("project_id")
  accessToken     String   @map("access_token")
  slackTeamId     String   @map("slack_team_id")
  slackTeamName   String   @map("slack_team_name")
  channelId       String?  @map("channel_id")
  channelName     String?  @map("channel_name")
  notifyOnCreated  Boolean @default(true) @map("notify_on_created")
  notifyOnShipped  Boolean @default(true) @map("notify_on_shipped")
  notifyOnDeployed Boolean @default(true) @map("notify_on_deployed")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_slack_connections")
}

model UserNotificationPreference {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  projectId        String              @map("project_id")
  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  digestFrequency  DigestFrequency?    @map("digest_frequency")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, notificationType, channel])
  @@map("user_notification_preferences")
}

model BlockedBranch {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  branchName  String   @map("branch_name")
  reason      String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([projectId, branchName])
  @@map("blocked_branches")
}

enum FlagHistoryEventType {
  flag_created
  flag_deleted
  flag_enabled
  flag_disabled
  flag_value_changed
  decision_enable_in_release
  decision_ship_off
  decision_in_progress
  conflict_detected
  reminder_sent
  sync_completed
  coverage_scan
  detected_definition
  detected_usage
  first_seen_branch

  @@map("flag_history_event_type")
}

enum FlagHistorySource {
  webhook
  sync
  user
  system

  @@map("flag_history_source")
}

model FlagHistoryEvent {
  id              String               @id @default(cuid())
  projectId       String               @map("project_id")
  flagKey         String               @map("flag_key")
  trackedFlagId   String?              @map("tracked_flag_id")
  flagsmithFlagId String?              @map("flagsmith_flag_id")
  type            FlagHistoryEventType
  environmentName String?              @map("environment_name")
  previousValue   String?              @map("previous_value")
  newValue        String?              @map("new_value")
  releaseId       String?              @map("release_id")
  actorId         String?              @map("actor_id")
  branchName      String?              @map("branch_name")
  prNumber        Int?                 @map("pr_number")
  detectedFile    String?              @map("detected_file")
  source          FlagHistorySource
  occurredAt      DateTime             @default(now()) @map("occurred_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trackedFlag   TrackedFlag?   @relation(fields: [trackedFlagId], references: [id], onDelete: SetNull)
  flagsmithFlag FlagsmithFlag? @relation(fields: [flagsmithFlagId], references: [id], onDelete: SetNull)
  release       Release?       @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, flagKey, occurredAt])
  @@index([projectId, occurredAt])
  @@map("flag_history_events")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  projectId String           @map("project_id")
  type      NotificationType
  title     String
  body      String
  url       String?
  flagKey   String?          @map("flag_key")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SummaryProfile {
  id             String    @id @default(cuid())
  projectId      String    @map("project_id")
  name           String
  description    String?
  outputTemplate String?   @map("output_template")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  project  Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rules    SummaryProfileRule[]
  examples SummaryProfileExample[]
  releases Release[]

  @@unique([projectId, name])
  @@index([projectId, deletedAt])
  @@map("summary_profiles")
}

model SummaryProfileRule {
  id               String   @id @default(cuid())
  summaryProfileId String   @map("summary_profile_id")
  content          String
  position         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")

  summaryProfile SummaryProfile @relation(fields: [summaryProfileId], references: [id], onDelete: Cascade)

  @@index([summaryProfileId])
  @@map("summary_profile_rules")
}

model SummaryProfileExample {
  id               String             @id @default(cuid())
  summaryProfileId String             @map("summary_profile_id")
  kind             SummaryExampleKind
  content          String
  explanation      String
  position         Int                @default(0)
  createdAt        DateTime           @default(now()) @map("created_at")

  summaryProfile SummaryProfile @relation(fields: [summaryProfileId], references: [id], onDelete: Cascade)

  @@index([summaryProfileId])
  @@map("summary_profile_examples")
}
